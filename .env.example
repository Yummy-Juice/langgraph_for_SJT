# Required: model service credential
API_KEY=replace_with_your_api_key
# Optional for OpenAI-compatible providers. Leave blank for the default endpoint.
BASE_URL=
MODEL_ID=deepseek-v4.1-flash
VIRTUAL_RESPONDENT_MODEL_ID=deepseek-v4.1-flash
VIRTUAL_RESPONDENT_THINKING=enabled
VIRTUAL_RESPONDENT_REASONING_EFFORT=high
# Frozen by the current virtual-response protocol; other values are rejected.
VIRTUAL_RESPONDENT_TEMPERATURE=1.5
MODEL_REQUEST_TIMEOUT_SECONDS=600
